<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bamboo_control</name>
  <version>0.0.0</version>
  <description>Groupe manette du robot bamboo4WD_V4 : traduit /joy en commandes de MODE du groupe videotracking et en deplacements RELATIFS des axes de servo. Publie aussi /cmd_vel, mais derriere DEUX verrous en serie : `motion_enabled` local au noeud, faux au demarrage, et `enable_cmd_vel` du driver, faux sur ce robot -- la manette ne peut donc pas contourner le second (voir teleop_node.py).</description>
  <maintainer email="titi28011976@users.noreply.github.com">Titi28011976</maintainer>
  <license>Apache 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <!-- SetParametersResult, retour du rappel qui rend `nudge_enabled` reglable a chaud. -->
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>bamboo_interfaces</exec_depend>
  <!-- Le launch de ce module importe bamboo_base.robot_config pour savoir ou vit le fichier
       canonique du robot (E2) : dependance d'EXECUTION, pas de construction. -->
  <exec_depend>bamboo_base</exec_depend>
  <!-- joy_linux et non joy : le paquet apt installe dans l'image est
       ros-humble-joy-linux (couche Dockerfile de la manette, verifiee 3/3 au
       lot V1.0). Les deux exposent /joy avec le MEME type mais des index
       d'axes differents, donc ne pas substituer l'un a l'autre sans relever. -->
  <exec_depend>joy_linux</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
