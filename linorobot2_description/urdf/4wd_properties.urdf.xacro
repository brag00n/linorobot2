<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_length" value="0.445" />
  <xacro:property name="base_width" value="0.200" />
  <xacro:property name="base_height" value="0.129" />
  <xacro:property name="base_mass" value="10" />

  <!-- Geometrie de roue : ARGUMENTS, pas des constantes. La verite physique vit dans
       bamboo_base/config/robots/<robot>.yaml et est passee par description.launch.py
       (wheel_radius = wheel_diameter_m / 2, wheel_pos_y = wheel_separation_m / 2).
       Les defauts ci-dessous sont les valeurs de l'amont linorobot2 : ce ne sont PAS des
       mesures de ce robot, elles ne servent qu'a garder le xacro utilisable seul. -->
  <xacro:arg name="wheel_radius" default="0.07162" />
  <xacro:arg name="wheel_pos_y" default="0.1355" />

  <xacro:property name="wheel_radius" value="$(arg wheel_radius)" />
  <xacro:property name="wheel_width" value="0.05" />
  <xacro:property name="wheel_pos_x" value="0.120" />
  <xacro:property name="wheel_pos_y" value="$(arg wheel_pos_y)" />
  <xacro:property name="wheel_pos_z" value="-0.04788" />
  <xacro:property name="wheel_mass" value=".6" />
  <xacro:property name="wheel_torque" value="20" />

  <xacro:property name="laser_pose">
    <origin xyz="-0.0475 0 0.125" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="depth_sensor_pose">
    <origin xyz="-0.065 0 0.255" rpy="0 0 0"/>
  </xacro:property>
</robot>