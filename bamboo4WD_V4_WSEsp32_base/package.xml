<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bamboo4WD_V4_WSEsp32_base</name>
  <version>0.0.0</version>
  <!-- Paquet de BRINGUP du ROBOT BambooWS. Pendant exact de bamboo4WD_V4_YBStm32_base :
       aucun noeud, seulement la COMPOSITION de cette machine-ci. La difference entre les
       deux paquets est la seule chose qui doive differer entre deux robots. La verite
       physique est dans config/bamboo4WD_V4_WSEsp32.yaml DE CE PAQUET depuis le lot BASCULE
       (2026-10-02), comme celle de bambooSTM32YB depuis E2.
       ATTENTION : ce robot est EN PAUSE (attache moteur M1 cassee), AUCUN essai au sol.
       Voir l'en-tete de launch/bringup.launch.py. -->
  <description>Bringup du robot bamboo4WD_V4_WSEsp32 (BambooWS) : carte WaveShare General
    Driver ESP32, jumeau du bringup de bambooSTM32YB. Robot EN PAUSE (aucun essai au sol).</description>
  <maintainer email="titi28011976@users.noreply.github.com">Titi28011976</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>bamboo_base</exec_depend>
  <!-- Le controleur de CE robot, et lui seul. -->
  <exec_depend>bamboo_controler_WSEsp32</exec_depend>
  <!-- Les groupes inclus par le bringup. bamboo_videotracking Y EST desormais : ce robot n'a
       AUCUN servo (DO_SET_SERVO repond UNSUPPORTED), et le groupe tourne alors en CAMERA
       FIXE : detection, reconnaissance, HUD, sans rien bouger. -->
  <exec_depend>bamboo_video</exec_depend>
  <exec_depend>bamboo_videotracking</exec_depend>
  <exec_depend>bamboo_control</exec_depend>
  <exec_depend>linorobot2_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
