# Calibration du glissement en rotation (bamboo_calibration), lancee depuis le mode
# `calibration` de la manette. Long (1 a 3 min), ANNULABLE, un seul but a la fois.
# Le robot TOURNE : il doit etre au sol, arme, avec de la place (arcs : ~2 m x 2 m).
string variant          # nom de la variante materielle mesuree (fichier candidat)
bool include_arcs       # ajoute les arcs (virages en avancant) aux rotations sur place
bool imu_check_only     # controle de l'IMU au repos seul, SANS mouvement
---
bool success
string summary_json     # rapport complet (paliers, table s, controles de qualite)
string candidate_path   # fichier candidat ecrit, vide si rien n'a ete ecrit
---
string line             # etape en clair, pour le journal et le HUD
int32 step
int32 total
