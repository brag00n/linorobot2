# 99-bambooWS.rules — ports serie STABLES du robot BambooWS.
# Pose par docker/install_bambooWS.sh dans /etc/udev/rules.d/. NE PAS editer sur l'hote :
# ces regles n'existaient que sur la machine, versionnees nulle part, et une reinstallation
# du RPi les perdait -- ce qui cassait le driver sans rien indiquer de la cause.
#
# POURQUOI par NUMERO DE SERIE et non par VID:PID : le CP2102 10c4:ea60 est porte par
# PLUSIEURS peripheriques de ce parc. Une regle sur le seul VID:PID leur donne a tous le
# meme symlink, et c'est le dernier enumere qui gagne -- le driver lidar ouvrirait alors
# l'ESP32 a 921600 en MAVLink, ou l'inverse. L'ordre d'enumeration USB n'etant pas garanti,
# la panne est intermittente, donc penible a diagnostiquer.
#
# Relever le numero de serie d'une carte branchee :
#   udevadm info -a -n /dev/ttyUSB0 | grep -E 'ATTRS\{(serial|idVendor|idProduct)\}'
# La casse compte : udev compare litteralement (ici en minuscules).

# --- Carte de controle : WaveShare General Driver (ESP32-WROOM-32), CP2102N -------------
# Proprietaire du port : le driver ROS `bamboo_base` (MAVLink v2, 921600 bauds), et l'outil
# de flash `flash.esp32`. Les deux referencent /dev/esp32, jamais /dev/ttyUSB*.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="d6607067ef3fed11996190b80a86e0b4", MODE:="0666", GROUP:="dialout", SYMLINK+="esp32"

# --- Lidar : Waveshare D500 (LDROBOT STL-19P), adaptateur CP2102 -----------------------
# MEME VID:PID que l'ESP32 (10c4:ea60) : seule le NUMERO DE SERIE les distingue. Proprietaire
# du port : bamboo_lidar (conteneur driver.lidarD500), qui reference /dev/lidar.
# Numero releve le 2026-10-10, lidar branche (essai Na) : "0001" -- le numero GENERIQUE
# des CP2102 bon marche (l'ancien adaptateur YDLidar portait le meme), DIFFERENT de celui de
# l'ESP32 (CP2102N). Relever a nouveau si l'adaptateur est change :
#   udevadm info -a -n /dev/ttyUSBx | grep -E 'ATTRS\{(serial|idVendor|idProduct)\}'
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="0001", MODE:="0666", GROUP:="dialout", SYMLINK+="lidar"
