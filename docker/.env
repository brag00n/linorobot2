# Robot type. Available variables: 2wd 4wd mecanum
ROBOT_BASE=4wd

# 2D laser scanner to be used. Available variables: ldlidar rplidar ydlidar xv11
LASER_SENSOR=ydlidar

# Depth sensor to be used. Available variables: realsense zed zedm zed2 zed2i
DEPTH_SENSOR="" 

# Type of installation. Available variables:
# simulation - Install Gazebo and plugins
# hardware - Install with microros
#DEPLOY=simulation
DEPLOY=hardware
# Projet distinct de la stack V2 (/root/workspace/bamboo4WD_V2) : images, conteneurs et
# reseau bridge sont namespaces par ce nom -> aucune collision. On ne fait PAS tourner les
# deux en meme temps (on stoppe V2 avant de lancer V4), donc V4 reprend 9090/8765.
COMPOSE_PROJECT_NAME=bamboov4_humble
#ROS_DISTRO=noetic
ROS_DISTRO=humble
BASE_GIT_LINOROBOT2=brag00n

# Robot pilote par cette pile, et LA SEULE BASCULE pour en changer : compose le lit et le
# propage en `robot:=` aux launch, qui en deduisent le fichier canonique
# bamboo_base/config/robots/<ROBOT>.yaml (geometrie, PID, table servo_axes) et la liste des
# controleurs de ce robot.
#   bamboo4WD_V4_YBStm32 = bambooSTM32YB, carte Yahboom STM32 (chantier tracking camera)
#   bamboo4WD_V4_WSEsp32 = BambooWS, carte WaveShare ESP32 (chantier en pause)
#
# NE PAS CONFONDRE AVEC ROBOT_BASE ci-dessus, et la ressemblance des noms est un vrai piege :
# ROBOT_BASE est la FAMILLE cinematique amont linorobot2 (2wd/4wd/mecanum), consommee a la
# CONSTRUCTION de l'image et par l'URDF. ROBOT est l'IDENTITE de la machine, consommee au
# LANCEMENT. Deux robots peuvent partager ROBOT_BASE=4wd et n'avoir ni la meme geometrie, ni
# la meme carte, ni les memes servos -- c'est exactement le cas de ces deux-la.
ROBOT=bamboo4WD_V4_YBStm32
