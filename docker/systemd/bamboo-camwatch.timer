# bamboo-camwatch.timer -- passe la surveillance de la camera toutes les 30 s.
#
# OnBootSec : le premier passage attend 4 min (le script ignore de toute facon les 240 premieres
# secondes du RPi). Persistent n'a pas de sens ici : on veut l'etat PRESENT, pas un rattrapage.
# Pose par install_bambooWS.sh (pas 8).    systemctl list-timers bamboo-camwatch

[Unit]
Description=Bamboo4WD : minuteur de surveillance de la camera

[Timer]
OnBootSec=4min
OnUnitActiveSec=30s
AccuracySec=5s
Unit=bamboo-camwatch.service

[Install]
WantedBy=timers.target
