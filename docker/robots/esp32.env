# Robot BambooWS -- lu par docker/robot.sh (`robot.sh use esp32`), qui en recopie les variables
# dans docker/.env. C'est le SEUL endroit qui lie l'etiquette `esp32` (profil compose des
# services propres a ce robot) a l'identifiant ROS du robot.
# Robot EN PAUSE : attache moteur N20 de M1 cassee, AUCUN essai au sol avant reparation.
ROBOT=bamboo4WD_V4_WSEsp32
# Camera de CE robot : << A CONFIRMER >> a l'essai T17 de BambooWS (v4l2-ctl --list-devices).
BAMBOO_CAM=/dev/video0
ROBOT_LABEL=BambooWS
