# Robot bambooSTM32YB -- lu par docker/robot.sh (`robot.sh use stm32`), qui en recopie les
# variables dans docker/.env. C'est le SEUL endroit qui lie l'etiquette `stm32` (profil compose
# des services propres a ce robot) a l'identifiant ROS du robot.
ROBOT=bamboo4WD_V4_YBStm32
# Camera : /dev/bamboocam des que la regle udev 99-bambooSTM32YB.rules est posee sur le RPi ;
# /dev/video0 en attendant (etat constate a T10 de bambooSTM32YB).
BAMBOO_CAM=/dev/video0
ROBOT_LABEL=bambooSTM32YB
