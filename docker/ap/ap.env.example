# Copier en docker/ap/secret/ap.env (dossier NON versionne, cf. .gitignore) et renseigner les
# deux mots de passe. Ils ne servent qu'au PREMIER demarrage : ensuite l'interface web fait foi
# (volume ap_state). Pour repartir de zero : docker volume rm <projet>_ap_state.
# Genere un mot de passe : head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 12
AP_SSID=Bamboo
AP_PASS=
AP_WEB_USER=admin
AP_WEB_PASS=
# Repli quand la box est absente : 5 GHz NON-DFS (36, 40, 44, 48). Jamais de 2,4 GHz (manette BT).
AP_CHANNEL_FALLBACK=36
# 0 = pas d'internet pour les clients de l'AP (HUD seul)
AP_NAT=1
# Port de l'interface web, servie sur 10.3.141.1 seulement (jamais sur l'adresse de la box)
AP_WEB_PORT=8081
